# ==============================================================================
# Demo 4: Cloud Agent Platform (GEAP) Environment (.env.example)
# ==============================================================================
# Google Cloud Account / User Identity for cloud platform deployment & invocation
GCLOUD_USER="admin@example.com"

# Target Google Cloud Project hosting Gemini Enterprise Agent Platform (GEAP)
GOOGLE_CLOUD_PROJECT="your-demo-project"

# Dedicated GCloud CLI configuration profile for workshop credential isolation
GCLOUD_PROFILE="antigravity-workshop"

# Isolated directory for workshop credentials and config
CLOUDSDK_CONFIG="${HOME}/.config/gcloud-workshop"

# Application Default Credentials (ADC) path pointing into isolated config directory
GOOGLE_APPLICATION_CREDENTIALS="${HOME}/.config/gcloud-workshop/application_default_credentials.json"

# Production Gemini Enterprise Agent Platform (GEAP) agent endpoint
GEAP_AGENT_URL="https://us-central1-your-demo-project.cloudfunctions.net/a2a/app"
