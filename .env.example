# ==============================================================================
# Google Cloud ADC & Workshop Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables to match your environment:
#   cp .env.example .env
#
# Then execute the one-time authentication helper:
#   ./scripts/gcloud_login.sh
#
# And source the environment in your presentation terminal:
#   source ./scripts/set_gcloud_env.sh
# ==============================================================================

# Google Cloud Account / User Identity for authentication
GCLOUD_USER="admin@example.com"

# Target Google Cloud Project ID for workshop telemetry and agents
GOOGLE_CLOUD_PROJECT="your-demo-project"

# Developer / Test Account granted read-only BigQuery access (Module 3)
DEMO_READER_USER="dev1@example.com"

# Dedicated GCloud CLI configuration profile for workshop credential isolation
GCLOUD_PROFILE="antigravity-workshop"

# Isolated directory for workshop credentials and config (prevents pollution of ~/.config/gcloud)
CLOUDSDK_CONFIG="${HOME}/.config/gcloud-workshop"

# Application Default Credentials (ADC) path pointing into the isolated config directory
GOOGLE_APPLICATION_CREDENTIALS="${HOME}/.config/gcloud-workshop/application_default_credentials.json"

# Production Gemini Enterprise Agent Platform (GEAP) endpoint (Module 4)
GEAP_AGENT_URL="https://us-central1-your-demo-project.cloudfunctions.net/a2a/app"

# Optional: Path or command name for Database MCP Toolbox binary (Module 3)
TOOLBOX_BIN="toolbox"
